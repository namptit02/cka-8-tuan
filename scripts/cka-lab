  t "metadata.labels có tier: backend" 'has v6 "    tier: backend"'
  t "template labels có tier: backend" 'has v6 "        tier: backend"'; }

title_v7="vim: bỏ comment một khối bằng Ctrl+V (≤45s)"; target_v7=45
task_v7(){ echo "Trong ~/cka-vim/v7.yaml, bỏ comment khối resources (4 dòng bắt đầu bằng '# '), giữ đúng thụt lề."; }
hint_v7(){ echo "Đặt con trỏ ở dấu # đầu tiên → Ctrl+V → 3j → l (chọn cả '# ') → d"; }
setup_v7(){ cat > "$(vf v7)" <<'Y'
apiVersion: v1
kind: Pod
metadata:
  name: v7
spec:
  containers:
  - name: app
    image: nginx
    # resources:
    #   requests:
    #     cpu: 100m
    #     memory: 128Mi
Y
}
check_v7(){ t "Khối resources đã bỏ comment, thụt lề đúng" 'has v7 "    resources:" && has v7 "      requests:" && has v7 "        cpu: 100m" && has v7 "        memory: 128Mi"'
  t "Không còn dấu #" '! grep -q "#" "$(vf v7)"'; }

title_v8="vim: sửa 2 lỗi trong manifest kube-apiserver (≤60s)"; target_v8=60
task_v8(){ echo "~/cka-vim/v8.yaml là bản sao manifest kube-apiserver có 2 lỗi: sai cổng etcd và sai tên file cert. Tìm và sửa."; }
hint_v8(){ echo "/etcd-servers → cổng etcd client là 2379 ; /tls-cert → tên file .crt"; }
setup_v8(){ cat > "$(vf v8)" <<'Y'
apiVersion: v1
kind: Pod
metadata:
  name: kube-apiserver
  namespace: kube-system
spec:
  containers:
  - command:
    - kube-apiserver
    - --advertise-address=192.168.64.5
    - --authorization-mode=Node,RBAC
    - --client-ca-file=/etc/kubernetes/pki/ca.crt
    - --etcd-cafile=/etc/kubernetes/pki/etcd/ca.crt
    - --etcd-servers=https://127.0.0.1:2380
    - --secure-port=6443
    - --service-cluster-ip-range=10.96.0.0/12
    - --tls-cert-file=/etc/kubernetes/pki/apiserver.crtt
    - --tls-private-key-file=/etc/kubernetes/pki/apiserver.key
    image: registry.k8s.io/kube-apiserver:v1.35.0
    name: kube-apiserver
Y
}
check_v8(){ t "etcd-servers dùng cổng 2379" 'has v8 "    - --etcd-servers=https://127.0.0.1:2379"'
  t "tls-cert-file đúng apiserver.crt" 'has v8 "    - --tls-cert-file=/etc/kubernetes/pki/apiserver.crt"'
  t "Không sửa nhầm dòng khác" '[ "$(wc -l < "$(vf v8)")" -eq 20 ] && has v8 "    - --tls-private-key-file=/etc/kubernetes/pki/apiserver.key"'; }
for v in v1 v2 v3 v4 v5 v6 v7 v8; do eval "reset_$v(){ rm -f \"\$(vf $v)\"; }"; done

# =====================================================================
ttl(){ local v="title_$1"; printf '%s' "${!v}"; }
tgt(){ local v="target_$1"; printf '%s' "${!v:-}"; }
valid(){ case " $IDS " in *" $1 "*) return 0;; esac; echo "Không có thử thách '$1'. Xem: cka-lab list"; exit 1; }
status_of(){ if grep -qx "$1" "$STATE/passed" 2>/dev/null; then echo "${G}✔ đạt${N}"; elif [ -f "$STATE/$1.start" ]; then echo "${Y}… đang làm${N}"; else echo "-"; fi; }
show_task(){ echo; echo "${B}${C}[$1] $(ttl "$1")${N}"; "task_$1"
  case "$1" in v*) echo "File: ${B}$(vf "$1")${N}   → vim $(vf "$1")";; esac
  echo; echo "Làm xong chạy: ${B}cka-lab check $1${N}   ·   gợi ý: cka-lab hint $1   ·   dọn: cka-lab reset $1"; }

cmd="${1:-help}"; id="${2:-}"
case "$cmd" in
  list|ls)
    echo "${B}cka-lab $VERSION${N} — thử thách Linux cho CKA"; echo
    for i in $IDS; do printf "  %-4s %-62s %s\n" "$i" "$(ttl "$i")" "$(status_of "$i")"; done
    echo; echo "Bắt đầu: cka-lab start c1" ;;
  start)
    [ -n "$id" ] || { echo "cka-lab start <id>"; exit 1; }; valid "$id"
    case "$id" in c*) sudo -v || exit 1;; esac
    "reset_$id" >/dev/null 2>&1; "setup_$id" || { echo "${R}Tạo thử thách thất bại${N}"; exit 1; }
    date +%s > "$STATE/$id.start"; show_task "$id" ;;
  task) valid "$id"; show_task "$id" ;;
  hint) valid "$id"; echo "${Y}Gợi ý:${N} $("hint_$id")" ;;
  check)
    valid "$id"; [ -f "$STATE/$id.start" ] || { echo "Chưa bắt đầu. Chạy: cka-lab start $id"; exit 1; }
    case "$id" in c*) sudo -v || exit 1;; esac
    echo "${B}Chấm [$id] $(ttl "$id")${N}"; "check_$id"
    el=$(( $(date +%s) - $(cat "$STATE/$id.start") )); tg="$(tgt "$id")"
    if [ "$FAIL" -eq 0 ]; then
      grep -qx "$id" "$STATE/passed" 2>/dev/null || echo "$id" >> "$STATE/passed"
      msg="${G}${B}ĐẠT${N} ($PASS/$PASS) — thời gian $((el/60))m$((el%60))s"
      [ -n "$tg" ] && { [ "$el" -le "$tg" ] && msg="$msg ${G}(trong mục tiêu ${tg}s)${N}" || msg="$msg ${Y}(mục tiêu ${tg}s — làm lại cho nhanh hơn)${N}"; }
      echo; echo "$msg"; echo "Dọn dẹp: cka-lab reset $id"
    else echo; echo "${R}${B}CHƯA ĐẠT${N} ($PASS/$((PASS+FAIL))). Gợi ý: cka-lab hint $id"; exit 2; fi ;;
  reset)
    [ -n "$id" ] || { echo "cka-lab reset <id|all>"; exit 1; }
    if [ "$id" = all ]; then sudo -v || exit 1; for i in $IDS; do "reset_$i" >/dev/null 2>&1; rm -f "$STATE/$i.start"; done; echo "Đã dọn toàn bộ tài nguyên cka-lab."
    else valid "$id"; case "$id" in c*) sudo -v || exit 1;; esac; "reset_$id" >/dev/null 2>&1; rm -f "$STATE/$id.start"; echo "Đã dọn [$id]."; fi ;;
  score)
    n=$(grep -c . "$STATE/passed" 2>/dev/null || echo 0); tot=$(echo $IDS | wc -w)
    echo "Đã đạt ${B}$n/$tot${N}: $(tr '\n' ' ' < "$STATE/passed" 2>/dev/null)" ;;
  version) echo "$VERSION" ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
