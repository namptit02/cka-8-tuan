  containers:
  - name: web
    image: nginx:1.27
Y
}
check_v5(){ t "Container web vẫn còn" 'has v5 "  - name: web" && has v5 "    image: nginx:1.27"'
  t "Có container sidecar image busybox" 'has v5 "  - name: sidecar" && has v5 "    image: busybox"'
