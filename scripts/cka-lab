title_v4="vim: thụt lề một khối dòng (≤45s)"; target_v4=45
task_v4(){ echo "Trong ~/cka-vim/v4.yaml, 4 dòng cuối (khối env) đang thiếu 2 dấu cách. Thụt chúng vào thêm 2 dấu cách."; }
hint_v4(){ echo ":set sw=2 → đặt con trỏ dòng '- name: MODE' → V → 3j → >"; }
