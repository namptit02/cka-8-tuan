apiVersion: v1
kind: Pod
metadata:
  name: v4
spec:
  containers:
  - name: app
    image: busybox
    command: ["sleep", "3600"]
    env:
  - name: MODE
    value: prod
  - name: LOG
    value: info
Y
}
check_v4(){ t "Khối env thụt đúng" 'has v4 "    - name: MODE" && has v4 "      value: prod" && has v4 "    - name: LOG" && has v4 "      value: info"'
  t "Dòng container không bị đụng tới" 'has v4 "  - name: app"'; }

