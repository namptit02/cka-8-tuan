hint_v5(){ echo "Đứng ở '  - name: web' → V → j (chọn 2 dòng) → y → G → p → sửa bằng cw ; thêm dòng command bằng o"; }
setup_v5(){ cat > "$(vf v5)" <<'Y'
apiVersion: v1
kind: Pod
